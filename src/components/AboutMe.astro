---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div
  class="flex flex-col-reverse gap-6 justify-center items-center md:flex-row"
>
  <div class="text-justify">
    <p class="mb-5">
      {t("about_me_text")}
    </p>
  </div>
  <img class="rounded-full size-52" src="/sj.jpg" alt="sergioj-pic" />
</div>
